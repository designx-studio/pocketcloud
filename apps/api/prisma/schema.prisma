// PostgreSQL schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  role            String     @default("OWNER")
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  sessions        Session[]
  auditLogs       AuditLog[]
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Server {
  id              String           @id @default(uuid())
  name            String
  provider        String
  ipAddress       String
  os              String
  architecture    String?
  environment     String?
  status          String           @default("PENDING")
  agent           Agent?
  metrics         HealthMetric[]
  heartbeats      Heartbeat[]
  tasks           Task[]
  blueprints      Blueprint[]
  bootstrapTokens BootstrapToken[]
  // Feature 1: Live Infrastructure Map
  region          String?
  latitude        Float?
  longitude       Float?
  // Feature 3: Free-Tier Lifecycle Tracking
  tierType        String?          // "always_free" | "trial" | "credit" | "paid"
  tierExpiresAt   DateTime?
  lifecycleRisk   String           @default("UNKNOWN") // "SAFE" | "WATCH" | "AT_RISK" | "UNKNOWN"
  lastActivityAt  DateTime?
  // Feature 4: Migration Planner
  role            String?          // "database" | "api" | "worker" | "dev" | ...
  importance      String           @default("STANDARD") // "CRITICAL" | "STANDARD" | "DISPOSABLE"
  // Feature 4: active blueprint link for dependency inference
  activeBlueprintId String?
  // Relations for new features
  dataBackups     DataBackup[]
  tunnelRoutes    TunnelRoute[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Agent {
  id             String    @id @default(uuid())
  serverId       String    @unique
  server         Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  version        String?
  publicKey      String?
  credentialHash String    @unique
  lastSeenAt     DateTime?
  connectedAt    DateTime?
  createdAt      DateTime  @default(now())
}

model BootstrapToken {
  id         String    @id @default(uuid())
  serverId   String
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime   @default(now())
}

model Task {
  id          String    @id @default(uuid())
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type        String
  payload     Json      @default("{}")
  status      String    @default("QUEUED")
  requestedBy String
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  logs        TaskLog[]
}

model TaskLog {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  level     String
  message   String
  createdAt DateTime @default(now())
}

model Blueprint {
  id              String             @id @default(uuid())
  serverId        String
  server          Server             @relation(fields: [serverId], references: [id])
  name            String
  versions        BlueprintVersion[]
  // Feature 5: Prebuilt Service Catalog
  slug            String?            @unique
  isSystemCatalog Boolean            @default(false)
  description     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model BlueprintVersion {
  id          String    @id @default(uuid())
  blueprintId String
  blueprint   Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  version     Int
  manifest    Json
  checksum    String
  createdAt   DateTime  @default(now())

  @@unique([blueprintId, version])
}

model HealthMetric {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpu         Float
  memory      Float
  disk        Float
  load        Float
  swap        Float
  uptime      BigInt   @default(0)
  collectedAt DateTime @default(now())

  @@index([serverId, collectedAt])
}

model Heartbeat {
  id         String   @id @default(uuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  payload    Json     @default("{}")
  receivedAt DateTime @default(now())

  @@index([serverId, receivedAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user         User?    @relation(fields: [userId], references: [id])
  action      String
  resource    String
  resourceId  String?
  metadata    String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  category  String   @default("advanced")
  isSecret  Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Backup {
  id        String   @id @default(uuid())
  path      String
  checksum  String
  createdAt DateTime @default(now())
  createdBy String
}

// Feature 2: Encrypted One-Click Backup & Restore
model DataBackup {
  id             String    @id @default(uuid())
  serverId       String
  server         Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  blueprintId    String?
  label          String
  sizeBytes      BigInt    @default(0)
  checksumSha256 String    @default("")
  storageKey     String
  storageBackend String    @default("local") // "s3" | "hetzner-storagebox" | "local"
  encrypted      Boolean   @default(true)
  status         String    @default("QUEUED") // QUEUED | RUNNING | COMPLETE | FAILED
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

// Feature 6: Notification Layer
model NotificationChannel {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "webhook" | "telegram" | "slack"
  target    String   // webhook URL, telegram chat_id, or slack webhook URL
  secret    String?  // for telegram bot token
  events    String[] // e.g. ["server.offline", "task.failed", "lifecycle.at_risk"]
  createdAt DateTime @default(now())
}

// Feature 8: Ingress/Tunnel for NAT'd Nodes
model TunnelRoute {
  id         String   @id @default(uuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  subdomain  String   @unique
  targetPort Int
  createdAt  DateTime @default(now())
}

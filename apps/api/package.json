{
  "name": "@pocketcloud/api",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:scheduler": "node dist/scheduler.js",
    "start:task-engine": "node dist/task-engine.js",
    "start:agent-registry": "node dist/agent-registry.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx src/worker.ts",
    "dev:scheduler": "tsx src/scheduler.ts",
    "dev:task-engine": "tsx src/task-engine.ts",
    "dev:agent-registry": "tsx src/agent-registry.ts",
    "test": "vitest run --coverage",
    "lint": "eslint src",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@pocketcloud/blueprint": "*",
    "@prisma/client": "^5.18.0",
    "argon2": "^0.31.2",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.9.1",
    "prettier": "^3.3.3",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vitest": "^2.0.5"
  }
}
# PocketCloud Environment Configuration
#
# Canonical production path (installer + Docker):
#   /opt/pocketcloud/.env
#
# Local development:
#   copy this file to the repository root as `.env`
#
# Do not commit real secrets.

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Public URLs ──────────────────────────────────────────
# Development example:
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
WS_URL=ws://localhost:8080
CORS_ORIGIN=*

# Production example (generated automatically by the installer):
# NODE_ENV=production
# APP_URL=https://cloud.example.com
# API_URL=https://cloud.example.com/api
# WS_URL=wss://cloud.example.com/ws
# CORS_ORIGIN=https://cloud.example.com
#
# Production rules:
# - CORS_ORIGIN must NOT be '*'
# - APP_URL and CORS_ORIGIN must be https:// origins
# - localhost is not allowed in production

# ─── Database ─────────────────────────────────────────────
# LOCAL DEV — SQLite (file-based, no server required)
# Run: npx prisma db push --schema prisma/schema.sqlite.prisma
DATABASE_URL=file:./dev.db

# PRODUCTION — PostgreSQL (set by the installer)
# DATABASE_URL=postgresql://pocketcloud:CHANGE_ME@database:5432/pocketcloud?schema=public

# ─── Authentication ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-jwt-secret-change-this-in-production-min-32-chars
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-this-in-production-min-32-chars
ENCRYPTION_KEY=dev-encryption-key-32bytes-change

# ─── Production only ──────────────────────────────────────
# POCKETCLOUD_DOMAIN=cloud.example.com
# POSTGRES_USER=pocketcloud
# POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

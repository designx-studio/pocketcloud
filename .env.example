# PocketCloud Environment Configuration
# Copy this file to .env and edit the values.
# For local development (SQLite, zero setup): no changes needed.
# For production (PostgreSQL): update DATABASE_URL.

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Database ─────────────────────────────────────────────
# LOCAL DEV — SQLite (file-based, no server required)
# Run: npx prisma db push --schema prisma/schema.sqlite.prisma
DATABASE_URL=file:./dev.db

# PRODUCTION — PostgreSQL (uncomment and fill in)
# DATABASE_URL=postgresql://pocketcloud:CHANGE_ME@localhost:5432/pocketcloud?schema=public

# ─── Authentication ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-jwt-secret-change-this-in-production-min-32-chars
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-this-in-production-min-32-chars
ENCRYPTION_KEY=dev-encryption-key-32bytes-change

# ─── CORS ─────────────────────────────────────────────────
# Local dev: allow all origins
CORS_ORIGIN=*

# Production: set to your actual domain
# CORS_ORIGIN=https://cloud.yourcompany.com

# ─── Production only ──────────────────────────────────────
# POCKETCLOUD_DOMAIN=cloud.yourcompany.com
# POSTGRES_USER=pocketcloud
# POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
